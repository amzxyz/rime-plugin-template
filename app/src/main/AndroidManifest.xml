<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <meta-data
            android:name="org.rime.plugin.API_VERSION"
            android:value="1" />
        <meta-data
            android:name="org.rime.plugin.RIME_API_ABI"
            android:value="1" />
        <meta-data
            android:name="org.rime.plugin.PLUGIN_ID"
            android:value="librime-evo" />
        <meta-data
            android:name="org.rime.plugin.SONAME"
            android:value="librime.so" />
        <meta-data
            android:name="org.rime.plugin.LIBRIME_VERSION"
            android:value="1.17.0" />
        <meta-data
            android:name="org.rime.plugin.CHANNEL"
            android:value="${pluginChannel}" />

        <activity
            android:name=".InfoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="org.rime.plugin.MANIFEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
